<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                   https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Catalog\Domain\Model\Session" table="sessions">
        <unique-constraints>
            <unique-constraint columns="experience_id,date" name="uniq_experience_day"/>
        </unique-constraints>
        <id name="id" type="session_id" column="id"/>
        <field name="experienceId" type="experience_id" column="experience_id"/>
        <field name="date" type="datetime_immutable"/>
        <field name="capacity" type="integer"/>
        <field name="availableSeats" type="integer" column="available_seats"/>
        <embedded name="price" class="App\Shared\Domain\ValueObject\Money" use-column-prefix="false"/>
    </entity>
</doctrine-mapping>